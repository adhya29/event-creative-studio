# =============================================================================
# LUMINA CREATIVE STUDIO — BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to server/.env (e.g. cp .env.example .env)
# Fill in your private keys before running in production mode.
# NEVER commit server/.env to GitHub or any public repository.
# =============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# =============================================================================
# VERIFIED SUPABASE PROJECT CONFIGURATION
# Project: lumina-creative-studio
# Region: West EU (Paris) / eu-west-3
# =============================================================================

# Project URL:
SUPABASE_URL=https://jgfkaahqitncvmdotxgg.supabase.co

# Anon / Public Key (Project Settings -> API -> Project API keys -> anon/public):
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Secret Key (Project Settings -> API -> Project API keys -> service_role):
# CRITICAL: Backend only! Bypasses Row Level Security for administrative queries.
# NEVER expose this key in frontend code, git commits, or client browser storage.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Storage Bucket (Supabase Dashboard -> Storage -> studio-media):
SUPABASE_STORAGE_BUCKET=studio-media

# =============================================================================
# ADMINISTRATOR CREDENTIALS (DEVELOPMENT MODE ONLY)
# In production mode, authentication is handled exclusively through Supabase Auth.
# In development (when Supabase credentials are blank), these credentials are used.
# =============================================================================
ADMIN_JWT_SECRET=lumina-studio-secret-key-super-secure-2026
ADMIN_EMAIL=admin@luminacreative.studio
ADMIN_DEFAULT_PASSWORD=AdminStudio@2026
