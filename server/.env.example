# =============================================================================
# LUMINA CREATIVE STUDIO — BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to server/.env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# =============================================================================
# SUPABASE CREDENTIALS
# Find these in: Supabase Dashboard > Project Settings > API
# =============================================================================

# Project URL (looks like: https://abcdefghijkl.supabase.co)
SUPABASE_URL=

# Anon (public) key — used by frontend clients (safe to expose)
SUPABASE_ANON_KEY=

# Service Role key — BACKEND ONLY, has full database access, NEVER expose to frontend
# Find under: Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for uploaded images
# Create this bucket in: Supabase Dashboard > Storage > New bucket > Name: studio-media > Public: ON
SUPABASE_STORAGE_BUCKET=studio-media

# =============================================================================
# ADMIN AUTHENTICATION (Development Mode Only)
# These credentials are ONLY used when Supabase is NOT configured.
# In production, authentication goes through Supabase Auth + admins table.
# =============================================================================

# Secret key for signing JWT tokens — CHANGE THIS to a long random string in production
ADMIN_JWT_SECRET=lumina-studio-secret-key-super-secure-2026

# Default login email for local development (ignored when Supabase is active)
ADMIN_EMAIL=admin@luminacreative.studio

# Default login password for local development (ignored when Supabase is active)
ADMIN_DEFAULT_PASSWORD=AdminStudio@2026
